{
  "name": "teramee",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:dev": "wrangler dev",
    "cf:deploy": "next build && wrangler deploy",
    "d1:create": "wrangler d1 create teramee-db",
    "d1:migrate": "wrangler d1 execute teramee-db --file=./schema.sql",
    "d1:migrate:local": "wrangler d1 execute teramee-db --local --file=./schema.sql"
  },
  "dependencies": {
    "css-tree": "^3.2.1",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.0"
  }
}
