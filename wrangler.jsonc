{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teramee",
  "compatibility_date": "2026-03-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    // Unknown URLs must be HTTP 404, not the homepage. "single-page-application"
    // served index.html with status 200 for every missing asset.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Navigation requests (compatibility date >= 2025-04-01) are served from
    // assets before the worker. These paths still need the worker: APIs,
    // profile existence checks (including /@handle), and the live sitemap.
    "run_worker_first": ["/api/*", "/user/*", "/@*", "/%40*", "/sitemap.xml", "/profile-shell"]
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teramee-db",
      "database_id": "f8d14f26-64e2-4cad-afc1-4312df729673"
    }
  ],
  "previews": {
    "ai": {
      "binding": "AI"
    }
  }
}
